# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# OAuth 2.0 Web client ID from Google Cloud Console:
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:3000
#
# Not a secret - it ships in the browser bundle. There is no client secret in
# this app; the Drive token is obtained client-side via Google Identity Services.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
