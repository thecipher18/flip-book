# Copy to .env.local and fill in. .env.local is gitignored; this file is not.
#
# The photo library lives in ONE Google account's Drive (the owner). Everyone
# else signs in only to prove who they are; the server reads and writes Drive
# on the owner's behalf. Photos are never link-shared.
#
# OAuth 2.0 Web client from Google Cloud Console:
#   APIs & Services -> Credentials -> Create credentials -> OAuth client ID
#   Application type: Web application
#   Authorized JavaScript origins: http://localhost:3000
#   Authorized redirect URIs:      http://localhost:53682  (for the mint script)

# Ships in the browser bundle. Not a secret.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# Same client ID again, read server-side to verify that incoming tokens were
# issued to this app and not some other one.
GOOGLE_CLIENT_ID=

# Secrets. Server-side only.
GOOGLE_CLIENT_SECRET=
# One-time: sign in as the OWNER account and run `npm run mint-token`.
GOOGLE_REFRESH_TOKEN=

# Comma-separated emails allowed to upload. Everyone else who signs in is
# read-only. Include the owner.
WRITER_EMAILS=owner@example.com
